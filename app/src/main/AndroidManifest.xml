<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (API 30+): allow detecting external EQs for Option B
         dual-player crossfade gate. Without this, getPackageInfo always misses. -->
    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.android.car.media" />
        <package android:name="com.android.car.carlauncher" />
        <package android:name="com.google.android.car.media" />
        <package android:name="com.google.android.carassistant" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.as" />
        <package android:name="com.google.android.apps.googleassistant" />
        <package android:name="com.maxmpz.equalizer" />
        <package android:name="com.pittvandewitt.wavelet" />
        <package android:name="com.mistersomov.wavelet" />
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>

    <!-- Android Auto drawer presence: MediaLibraryService + MediaBrowserService
         intent + com.google.android.gms.car.application → automotive_app_desc media. -->
    <!-- Voice search uses authorized MediaLibrarySession callbacks. Do not export a
         direct MEDIA_PLAY_FROM_SEARCH intent that bypasses controller authentication. -->
    <application
        tools:ignore="MissingIntentFilterForMediaSearch"
        android:name=".SonveilApp"
        android:appCategory="audio"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sonveil"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <!-- Required for Sonveil to appear in the Android Auto app list (media category). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/ic_stat_sonveil" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Sonveil">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.player.PlaybackService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:foregroundServiceType="mediaPlayback">
            <!-- Media3 + platform MediaBrowserService in one filter for PackageManager discovery. -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Local cover URIs for Android Auto / AAOS (HTTP artwork is rejected by the host). -->
        <provider
            android:name=".data.art.CoverArtContentProvider"
            android:authorities="app.sonveil.music.coverart"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>
